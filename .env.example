# Required. Get a key from https://console.typesafe.ai
TYPESAFE_API_KEY=

# Optional. Enables Gemini comparisons in the scenarios and follow-up tests.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Follow-up scripts pin their recorded model versions.
# The replay script accepts --model gemini-3.8-flash (its default).
